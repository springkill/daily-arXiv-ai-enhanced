# 复制为 .env.local 后按需修改。.env.local 不进 git(见 .gitignore)。
#   cp .env.local.example .env.local

# ─── 抓取 ────────────────────────────────────────────────────────────────
# 关注的 arXiv 类别,逗号分隔,按相关度排序(前端与 Markdown 据此排类目)。
# 注意:抓的是 arxiv.org/list/<类别>/new,里面包含 cross-list 的论文,
# 且爬虫按 id 去重 —— 所以 cs.AI 这种"到处 cross-list"的类别通常不必单独加。
CATEGORIES=cs.CR,cs.SE,cs.LG,cs.CL

# 摘要语言,只能是 Chinese 或 English(前端按文件名识别)
LANGUAGE=Chinese

# ─── LLM 提供方 ──────────────────────────────────────────────────────────
# 本项目不需要任何第三方 API key,它调用的是你本机已登录的编码助手 CLI,
# 走你自己的订阅额度。两者选一:
#   claude → 需要 Claude Code (https://claude.com/claude-code),先 `claude` 登录
#   codex  → 需要 Codex CLI    (https://developers.openai.com/codex/cli),先 `codex login`
# 不设则按 PATH 里有谁自动挑(claude 优先)。
LLM_PROVIDER=claude

# 三档模型。fast 用于批量预筛/打标/选会议,mid 常规,deep 最强。
CLAUDE_MODEL_FAST=haiku
CLAUDE_MODEL_MID=sonnet
CLAUDE_MODEL_DEEP=opus
# Codex 用户:不设就沿用你 ~/.codex/config.toml 里的默认模型。
# 想分档就填,例如:
#CODEX_MODEL_FAST=gpt-5.1-codex-mini
#CODEX_MODEL_MID=gpt-5.1-codex
#CODEX_MODEL_DEEP=gpt-5.1-codex-max

# CLI 路径。cron 环境的 PATH 往往不全,建议显式写绝对路径(`which claude`)。
#CLAUDE_BIN=/home/you/.nvm/versions/node/vXX/bin/claude
#CODEX_BIN=/home/you/.nvm/versions/node/vXX/bin/codex

LLM_TIMEOUT=240
LLM_RETRIES=2

# ─── 每日流水线 ──────────────────────────────────────────────────────────
# 每篇论文都会拿到 fast 档的完整五段总结;其中相关分 >= 阈值且当天 Top-K 的
# 会再用 deep 档重写一遍。Top-K 是花费闸门,调大更贵更慢。
RELEVANCE_THRESHOLD=6
DEEP_TOP_K=60
PREFILTER_BATCH=8
PREFILTER_WORKERS=4
DEEP_WORKERS=3

# ─── 后端 API(已标记 + 一键审稿)─────────────────────────────────────────
# 默认只绑回环。若 nginx 在容器里、要访问宿主上的本服务,绑到 docker 网桥上的
# 宿主地址(`docker network inspect <网络名>` 看 Gateway,常见 172.17.0.1)。
# 绝不要绑 0.0.0.0 —— 审稿会真花钱。
#REVIEW_BIND=172.17.0.1
REVIEW_PORT=8801
REVIEW_MAX_CONCURRENT=2

# sqlite 存储目录(标记 + 审稿结果)。默认 <仓库>/var,已 gitignore。
# ⚠️ 不要指到 sshfs/NFS 挂载点:sqlite 在 FUSE 上锁语义不可靠,会静默损坏数据。
#ARXIV_STORE_DIR=/abs/path/to/var

# 审稿意见的默认语言(en / zh-CN)。前端会随请求带上当前界面语言,
# 这个默认值只在请求没带语言时生效。
REVIEW_DEFAULT_LANG=en

# 摘要语言(后端读的是这个名字,不是 LANGUAGE)。
# LANGUAGE 是 POSIX locale 变量,桌面会话里常常已经是 zh_CN:en,
# 长驻服务会继承它 —— 所以后端专门用了另一个名字。
ARXIV_LANGUAGE=Chinese
