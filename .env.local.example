# 复制为 .env.local 并按需修改 / Copy to .env.local and edit.
# .env.local 不会被提交(见 .gitignore)。
CATEGORIES=cs.CR,cs.SE,cs.LG,cs.CL
LANGUAGE=Chinese
PREFILTER_MODEL=haiku
DEEP_MODEL=opus
RELEVANCE_THRESHOLD=6
DEEP_TOP_K=60
PREFILTER_BATCH=12
PREFILTER_WORKERS=4
DEEP_WORKERS=3
CLAUDE_BIN=/home/user/.nvm/versions/node/v24.13.0/bin/claude
